{
  "name": "sightline-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,server\" -c \"cyan,magenta\" \"npm run dev --workspace=web\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
